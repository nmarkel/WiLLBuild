# Python bytecode, venvs, and test caches (broad — covers geometry-service,
# scripts/spec-parse, scripts/step-to-glb, render-rig, etc.)
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Geometry service generated CAD/BIM output
geometry-service/out/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Test coverage output (vitest --coverage)
coverage/

# Env files — real values never committed; keep the tracked *.example templates
.env
.env.*
!.env.*.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Real-geometry render-rig inputs (offline only — large STEP/GLB, never shipped)
scripts/render-rig/real-assets/
# ...and the same path as a SYMLINK. A trailing-slash pattern matches only real
# directories, so a worktree that symlinks these in from the main checkout (the
# usual way to run the rig/tests without duplicating 569 MB) left them showing
# as untracked and one `git add -A` from being committed.
scripts/render-rig/real-assets
geometry-service/.venv

# Agent tooling scratch (per-machine, not project source)
.agents/
skills-lock.json

# Large raw engineering CAD source zips (not app build inputs) — keep out of git
geometry-service/*.zip

# Customer-cleared STEP files are staged (scripts/stage-customer-step.py), not
# committed — only the SHA-256 manifest travels in git (Phase 0.19).
geometry-service/assets/customer-step/*.STEP
geometry-service/assets/customer-step/*.step
